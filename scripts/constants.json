{
  "builds": {
    "node": {
      "define": {
        "__ENVIRONMENT__": "\"production\"",
        "__PLATFORM__": "\"node\""
      },
      "entryPoints": ["src/index.ts"],
      "mainFields": ["module", "main"],
      "outdir": "lib/node",
      "platform": "node",
      "target": ["node24.15.0"]
    }
  },
  "declaration": {
    "declarationRollup": true,
    "documentation": true,
    "entryPoints": ["src/index.ts"],
    "tsconfig": "tsconfig-build.json"
  }
}
