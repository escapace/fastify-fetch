{
  "name": "fastify-fetch",
  "description": "Fastify plugin that decorates the Fastify instance with app.fetch and routes requests through internal injection or external fetch according to policy.",
  "version": "0.0.0",
  "author": {
    "name": "escapace",
    "email": "opensource@escapace.com"
  },
  "bugs": "https://github.com/escapace/fastify-fetch/issues",
  "dependencies": {
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@ast-grep/napi": "0.45.1",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@escapace/pnpm-pack": "0.9.2",
    "@escapace/syncpack-configuration": "0.3.0",
    "@ls-lint/ls-lint": "2.3.1",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.8.1",
    "eslint-config-escapace": "5.20.3",
    "esroll": "1.3.1",
    "fastify": "5.12.1",
    "fastify-plugin": "6.0.0",
    "knip": "6.32.2",
    "lefthook": "2.1.10",
    "light-my-request": "6.6.0",
    "mlly": "1.8.2",
    "prettier": "3.9.6",
    "prettier-config-escapace": "1.2.2",
    "syncpack": "15.3.3",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "warn",
      "version": "^10.33.0"
    },
    "runtime": {
      "name": "node",
      "onFail": "warn",
      "version": "^24.15.0"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/node/index.js"
    }
  },
  "files": [
    "NOTICE",
    "lib/node",
    "lib/types"
  ],
  "homepage": "https://github.com/escapace/fastify-fetch#readme",
  "license": "MPL-2.0",
  "module": "./lib/node/index.js",
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": "escapace/fastify-fetch",
  "scripts": {
    "build": "pnpm run codegen && tsx scripts/build.ts",
    "codegen": "tsx scripts/codegen.ts",
    "format": "syncpack format && eslint --no-warn-ignored --fix && prettier --no-error-on-unmatched-pattern -uw .",
    "lint": "ls-lint --config .ls-lint.yaml && knip --no-config-hints && eslint",
    "ls-lint": "ls-lint --config .ls-lint.yaml",
    "pack": "pnpm-pack package --pack-destination lib",
    "prepare": "lefthook install",
    "syncpack": "syncpack fix && syncpack format",
    "test": "vitest --no-watch --coverage",
    "typecheck": "tsc --noEmit",
    "update": "ncu --cooldown 7 -p pnpm -u --peer --dep dev,peer,prod,optional && pnpm run syncpack"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./lib/types/index.d.ts"
}
